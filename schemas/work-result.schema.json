{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation or fix work result",
  "description": "Optional structured metadata recorded after implementation or review fixes. Omission of ui_review preserves the current selection; an explicitly empty ui_review clears it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "ui_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenarios": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          }
        }
      }
    }
  }
}
